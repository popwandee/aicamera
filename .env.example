# Database Configuration
DATABASE_URL="postgresql://aicamera:aicamera123@localhost:5432/aicamera"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# MQTT Configuration
MQTT_URL="mqtt://localhost:1883"

# JWT Configuration
JWT_SECRET="your-super-secure-jwt-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Service URLs (for microservice communication)
API_GATEWAY_URL="http://localhost:3000"
MQTT_SERVICE_URL="http://localhost:3001"
WEBSOCKET_SERVICE_URL="http://localhost:3002"
FILE_SERVICE_URL="http://localhost:3003"

# Storage Configuration
STORAGE_PATH="./storage"
MAX_FILE_SIZE="52428800"  # 50MB in bytes

# SFTP Configuration
SFTP_PORT="2222"
SFTP_HOST_KEY_PATH="./config/ssh/host_keys"

# Dashboard Configuration
VITE_API_URL="http://localhost:3000"
VITE_WS_URL="ws://localhost:3002"

# Development Configuration
NODE_ENV="development"
LOG_LEVEL="info"

# Security Configuration
CORS_ORIGINS="http://localhost:8080,http://localhost:5173"
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX="100"  # requests per window

# File Transfer Configuration
RSYNC_SSH_KEY_PATH="./config/ssh/rsync_key"
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
THUMBNAIL_SIZE="200x200"
PREVIEW_SIZE="800x600"