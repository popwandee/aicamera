# AI Camera Edge System - Environment Configuration Template
# Copy this file to .env.production and customize the REQUIRED values below.
#
# Network topology (Tailscale VPN):
#   lprserver.tail605477.ts.net  100.95.46.128  — central server (Nginx :80, MQTT :1883)
#   aicamera1.tail605477.ts.net  100.126.178.74 — edge camera 1 (imx708)
#   aicamera2.tail605477.ts.net  100.110.20.53  — edge camera 2 (imx708 NoIR)
#
# REQUIRED values to set per camera:
#   AICAMERA_ID       — unique integer (1 for aicamera1, 2 for aicamera2)
#   CHECKPOINT_ID     — same as AICAMERA_ID unless you have separate checkpoints
#   CAMERA_LOCATION   — human-readable description
#   CAMERA_IP         — this camera's Tailscale IP
#   LOCATION_LAT/LON  — GPS coordinates
#   CAMERA_SENSOR_TYPE — imx708 (aicamera1) or imx708_noir (aicamera2)
#   SECRET_KEY        — random string, change before deploying

# =============================================================================
# AI CAMERA IDENTIFICATION  [REQUIRED - UNIQUE PER CAMERA]
# =============================================================================
AICAMERA_ID=1
CHECKPOINT_ID=1
CAMERA_LOCATION="Main Entrance"
# Tailscale IP of this camera: aicamera1=100.126.178.74  aicamera2=100.110.20.53
CAMERA_IP=100.126.178.74
CAMERA_NAME=aicamera1
# Used internally for MQTT client_id and device registration
DEVICE_ID=aicamera1
DEVICE_MODEL=AI-CAM-EDGE-V2
DEVICE_LOCATION="Main Entrance"
DEVICE_VERSION=2.0.0

# =============================================================================
# SERVER ENDPOINTS  [VALIDATED - lprserver.tail605477.ts.net]
# =============================================================================
# All traffic reaches lprserver through Nginx on port 80.
# Do NOT use port 3000 (backend-api internal) or 3001 (ws-service internal).

# REST API base URL (global prefix /server/api is required)
SERVER_URL=http://lprserver.tail605477.ts.net/server/api
SERVER_HOST=lprserver.tail605477.ts.net
SERVER_PORT=80

# WebSocket / Socket.IO — Nginx proxies /ws/ → ws-service :3001
# The edge code detects "/ws" in this URL and connects with socketio_path="/ws/"
WEBSOCKET_SERVER_URL=http://lprserver.tail605477.ts.net/ws/
WEBSOCKET_ENABLED=true
WEBSOCKET_CONNECTION_TIMEOUT=30.0
WEBSOCKET_RETRY_INTERVAL=60.0
WEBSOCKET_MAX_RETRIES=5
WEBSOCKET_RECONNECT_ATTEMPTS=5
WEBSOCKET_RECONNECT_DELAY=5

# MQTT Broker — Mosquitto on lprserver, port 1883 is accessible via Tailscale
# Server subscribes to: camera/{id}/health  camera/{id}/status  camera/{id}/detections
MQTT_ENABLED=true
MQTT_BROKER_HOST=lprserver.tail605477.ts.net
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=camera
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERTS=
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=

# SFTP — upload captured images to lprserver storage
# Storage path on server: /home/devuser/aicamera/server/storage/{camera_id}/
SERVER_SFTP_ENABLED=true
SERVER_SFTP_HOST=lprserver.tail605477.ts.net
SERVER_SFTP_PORT=22
SERVER_SFTP_USERNAME=devuser
SERVER_SFTP_PASSWORD=admin88366
SERVER_SFTP_REMOTE_PATH=/home/devuser/aicamera/server/storage
SFTP_KEY_FILE=
SFTP_KEY_PASSPHRASE=

# Device registration via REST — disabled: camera_register WebSocket event handles this
DEVICE_REGISTRATION_ENABLED=false

# =============================================================================
# HAILO AI MODEL CONFIGURATION  [REQUIRED - match your device]
# =============================================================================
# HAILO8 (26 TOPS) — default for Raspberry Pi 5 + Hailo-8 M.2
VEHICLE_DETECTION_MODEL=yolov8n_relu6_car--640x640_quant_hailort_hailo8_1
LICENSE_PLATE_DETECTION_MODEL=yolov8n_relu6_lp--640x640_quant_hailort_hailo8_1
LICENSE_PLATE_OCR_MODEL=yolov8n_relu6_lp_ocr--256x128_quant_hailort_hailo8_1

# HAILO8L (13 TOPS) — uncomment if using Hailo-8L variant
#VEHICLE_DETECTION_MODEL=yolov8n_relu6_car--640x640_quant_hailort_hailo8l_1
#LICENSE_PLATE_DETECTION_MODEL=yolov8n_relu6_lp--640x640_quant_hailort_hailo8l_1
#LICENSE_PLATE_OCR_MODEL=yolov8n_relu6_lp_ocr--256x128_quant_hailort_hailo8l_1

# =============================================================================
# CAMERA HARDWARE  [REQUIRED - choose sensor per device]
# =============================================================================
# aicamera1: imx708        (standard, IR cut filter)
# aicamera2: imx708_noir   (no IR cut filter — enables software colour correction)
CAMERA_SENSOR_TYPE=imx708

# NoIR software colour correction — only active when CAMERA_SENSOR_TYPE=imx708_noir
# Calibrate against a white/grey card outdoors in daylight
NOIR_AWB_ENABLED=false
NOIR_COLOUR_GAIN_RED=1.8
NOIR_COLOUR_GAIN_BLUE=2.6

CAMERA_DEVICE=/dev/video0
CAMERA_RESOLUTION=640x640
MAIN_RESOLUTION=640x640
LORES_RESOLUTION=640x640
CAMERA_FPS=15
CAMERA_BRIGHTNESS=0.0
CAMERA_CONTRAST=1.0
CAMERA_SATURATION=1.0
CAMERA_SHARPNESS=2.0
CAMERA_NOISE_REDUCTION_MODE=0
CAMERA_AWB_MODE=0
# Autofocus: 0=Manual 1=Auto 2=Continuous (Auto is most stable for LPR)
DEFAULT_AUTOFOCUS_MODE=1
DEFAULT_AUTOFOCUS_ENABLED=true

# =============================================================================
# LOCATION  [REQUIRED - set GPS coordinates for this camera]
# =============================================================================
LOCATION_LAT=13.729610
LOCATION_LON=100.501443
LOCATION_ALT=0

# =============================================================================
# DETECTION  [optional - defaults work for most LPR deployments]
# =============================================================================
DETECTION_CONFIDENCE_THRESHOLD=0.8
PLATE_CONFIDENCE_THRESHOLD=0.5
DETECTION_INTERVAL=0.1
MAX_DETECTIONS_PER_FRAME=10

TRACKING_ENABLED=true
REENTRY_TIME_THRESHOLD=30.0
IOU_THRESHOLD=0.2

# =============================================================================
# STORAGE  [optional]
# =============================================================================
IMAGE_SAVE_DIR=captured_images
DATABASE_PATH=db/lpr_data.db
LOG_DIR=logs
LOG_LEVEL=INFO
MAX_STORAGE_GB=10
IMAGE_RETENTION_DAYS=30

LOCAL_STORAGE_PATH=./captured_images
CAPTURED_IMAGES_PATH=captured_images

STORAGE_MANAGER_ENABLED=true
STORAGE_MONITOR_ENABLED=true
STORAGE_MONITOR_INTERVAL=300
STORAGE_MIN_FREE_SPACE_GB=10.0
STORAGE_RETENTION_DAYS=7
STORAGE_BATCH_SIZE=100
STORAGE_ALERT_THRESHOLD=80

IMAGE_COMPRESSION_ENABLED=true
IMAGE_COMPRESSION_QUALITY=85
TRANSFER_RETRY_INTERVAL=60
MAX_TRANSFER_RETRIES=3

# =============================================================================
# FLASK / WEB  [optional]
# =============================================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Change SECRET_KEY to a random string before production deployment
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false

ENABLE_AUTH=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
API_RATE_LIMIT=100

# =============================================================================
# PERFORMANCE  [optional]
# =============================================================================
SENDER_INTERVAL=60
HEALTH_SENDER_INTERVAL=300
HEALTH_CHECK_INTERVAL=3600
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=30
GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# =============================================================================
# AUTO-STARTUP  [optional]
# =============================================================================
AUTO_START_CAMERA=true
AUTO_START_STREAMING=true
AUTO_START_DETECTION=true
AUTO_START_HEALTH_MONITOR=true
AUTO_START_WEBSOCKET_SENDER=true
AUTO_START_STORAGE_MONITOR=true
STARTUP_DELAY=5
HEALTH_MONITOR_STARTUP_DELAY=30
WEBSOCKET_SENDER_STARTUP_DELAY=10
STORAGE_MONITOR_STARTUP_DELAY=5

# =============================================================================
# MONITORING / BACKUP  [optional]
# =============================================================================
ENABLE_MONITORING=true
MONITORING_INTERVAL=60
ALERT_EMAIL=

ENABLE_BACKUP=false
BACKUP_INTERVAL=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backups

# =============================================================================
# EXPERIMENT  [optional]
# =============================================================================
EXPERIMENT_ENABLED=true
EXPERIMENT_AUTO_SAVE=true
EXPERIMENT_MAX_RETRIES=3

# =============================================================================
# NETWORK TUNING  [optional]
# =============================================================================
NETWORK_TIMEOUT=30
NETWORK_RETRY_DELAY=5
NETWORK_MAX_RETRIES=3

# =============================================================================
# GITHUB  [optional - only needed if using GitHub integration]
# =============================================================================
# Generate token at: https://github.com/settings/tokens (scopes: repo, issues)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=popwandee/aicamera
ISSUES_FILE=.github/ISSUES_FROM_PLAN.md

# =============================================================================
# INSTALLATION INSTRUCTIONS
# =============================================================================
# 1. Copy to .env.production:
#    cp env.production.template .env.production
#
# 2. Edit the REQUIRED section at the top for this specific camera:
#    - AICAMERA_ID / CHECKPOINT_ID (1 for aicamera1, 2 for aicamera2)
#    - CAMERA_IP (Tailscale IP of this camera)
#    - CAMERA_LOCATION / LOCATION_LAT / LOCATION_LON
#    - CAMERA_SENSOR_TYPE (imx708 or imx708_noir)
#    - SECRET_KEY (random string)
#
# 3. Server endpoints are already set for lprserver.tail605477.ts.net.
#    Do NOT change SERVER_PORT to 3000 or 3001 — those are internal ports.
#
# 4. Run the installation script:
#    ./install.sh
#
# For debug commands and architecture details, see edge/CLAUDE.md
